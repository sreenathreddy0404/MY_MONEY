generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// All money fields are INTEGER PAISE. Never floats.

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Incremented on logout / password change; JWTs carrying an older value are rejected.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts   Account[]
  categories Category[]
  expenses   Expense[]
  incomes    Income[]
  transfers  Transfer[]
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  accountName     String
  bankName        String   @default("")
  accountType     String   @default("Savings")
  lastFourDigits  String   @default("")
  openingBalance  Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  incomes      Income[]
  transfersOut Transfer[] @relation("TransferFrom")
  transfersIn  Transfer[] @relation("TransferTo")

  @@unique([userId, accountName])
  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   @default("expense")
  color     String   @default("#94a3b8")
  // The fallback category ("Other") receives expenses of deleted categories and cannot be deleted.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Expense {
  id         String   @id @default(cuid())
  userId     String
  accountId  String
  categoryId String
  amount     Int
  reason     String
  notes      String   @default("")
  date       DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: an account / category with history can't be deleted out from under it.
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, accountId])
  @@index([userId, categoryId])
}

model Income {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  amount      Int
  source      String
  description String   @default("")
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, accountId])
}

model Transfer {
  id            String   @id @default(cuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amount        Int
  note          String   @default("")
  date          DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, fromAccountId])
  @@index([userId, toAccountId])
}
